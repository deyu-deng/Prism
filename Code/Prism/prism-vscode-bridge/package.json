{
  "name": "prism-vscode-bridge",
  "displayName": "Prism Bridge",
  "description": "Real-time bridge from Prism Electron app to VSCode Claude Code",
  "version": "0.1.0",
  "publisher": "plobi",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "prismBridge.reconnect",
        "title": "Reconnect to Prism",
        "category": "Prism"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@types/vscode": "^1.74.0",
    "@types/ws": "^8.5.10",
    "typescript": "~5.8.3"
  }
}

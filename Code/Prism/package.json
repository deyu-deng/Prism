{
  "name": "prism",
  "private": true,
  "version": "0.1.0-alpha",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"vite build --config vite.config.electron.ts --watch\" \"wait-on tcp:127.0.0.1:1435 dist-electron/main.cjs dist-electron/preload.cjs && electron dist-electron/main.cjs\"",
    "build:electron": "vite build --config vite.config.electron.ts",
    "build:react": "tsc && vite build",
    "build": "npm run build:react && npm run build:electron",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tailwindcss/vite": "^4.3.0",
    "chokidar": "^3.6.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "framer-motion": "^12.40.0",
    "fuse.js": "^7.3.0",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^8.2.2",
    "electron": "^29.4.6",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.7",
    "wait-on": "^7.2.0"
  }
}
